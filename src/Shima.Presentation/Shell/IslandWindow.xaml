<Window x:Class="Shima.Presentation.Shell.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Shima.Presentation.Shell"
        Title="Shima Dynamic Island"
        Width="136"
        Height="28"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.Name="Shima Dynamic Island"
        AutomationProperties.AutomationId="ShimaIslandWindow"
        MouseEnter="OnWindowMouseEnter"
        MouseMove="OnWindowMouseMove"
        MouseLeave="OnWindowMouseLeave"
        MouseLeftButtonUp="OnWindowMouseLeftButtonUp"
        PreviewMouseLeftButtonDown="OnWindowPreviewMouseLeftButtonDown"
        PreviewMouseMove="OnWindowPreviewMouseMove"
        PreviewMouseLeftButtonUp="OnWindowPreviewMouseLeftButtonUp"
        LostMouseCapture="OnWindowLostMouseCapture"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Shima.Presentation;component/Theming/ThemeTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PillActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource SurfacePillButton}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderHairline}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="FontFamily" Value="{DynamicResource ShimaFontFamily}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BorderRoot"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BorderRoot" Property="Background" Value="{DynamicResource SurfacePillButtonHover}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="BorderRoot" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
                                    <Setter TargetName="BorderRoot" Property="BorderThickness" Value="2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="WindowViewportGrid" Background="{x:Null}">
        <Grid x:Name="RootContainer"
              Width="136"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Background="{x:Null}">
            <!-- Main Island Surface Capsule / Notch + Inner Content -->
            <Grid x:Name="MainIslandSurfaceHost"
                  Width="136"
                  Height="28"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  RenderTransformOrigin="0,0">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="MorphScaleTransform" ScaleX="1" ScaleY="1" CenterX="68" CenterY="0" />
                        <ScaleTransform x:Name="LiftScaleTransform" ScaleX="1" ScaleY="1" CenterX="68" CenterY="14" />
                    </TransformGroup>
                </Grid.RenderTransform>

                <!-- Dedicated non-hit-testable shadow path keeps text glyphs sharp and zero shader overhead when Docked idle -->
                <Path x:Name="IslandShadowPath"
                      Fill="{DynamicResource SurfaceCollapsed}"
                      StrokeThickness="0"
                      Stretch="None"
                      IsHitTestVisible="False"
                      Visibility="Collapsed" />

                <Path x:Name="NotchSurfacePath"
                      Fill="{DynamicResource SurfaceCollapsed}"
                      Stroke="{DynamicResource BorderHairline}"
                      StrokeThickness="1"
                      Stretch="None" />

                <!-- Collapsed notch status indicator (e.g., opt-in Developer Activity bar when alone) -->
                <ContentPresenter x:Name="CollapsedOverlayContentPresenter"
                                  Margin="{DynamicResource IslandCollapsedOverlayPadding}"
                                  VerticalAlignment="Bottom"
                                  Visibility="Collapsed" />

                <!-- Compact active pill content (Now Playing row stays intact) -->
                <Grid x:Name="ActiveLayer"
                      Margin="{DynamicResource IslandActivePillPadding}"
                      Visibility="Collapsed">
                    <StackPanel x:Name="ActiveDefaultBadgePanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Ellipse Width="7"
                                 Height="7"
                                 Fill="{DynamicResource AccentBrush}"
                                 Margin="0,0,7,0"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="ActiveBadgeText"
                                   FontFamily="{DynamicResource ShimaFontFamily}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Text="Active"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <ContentPresenter x:Name="ActiveCustomContentPresenter"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed" />
                </Grid>

                <!-- Bottom-edge Developer Activity companion bar tucked along pill bottom edge -->
                <Border x:Name="ActiveCompanionHost"
                        Margin="28,0,28,2.5"
                        Height="4"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Stretch"
                        Opacity="0"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        RenderTransformOrigin="0.5,1"
                        AutomationProperties.AutomationId="ActiveCompanionHost">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="ActiveCompanionScaleTransform" ScaleX="1" ScaleY="0.2" />
                    </Border.RenderTransform>
                    <ContentPresenter x:Name="ActiveCompanionContentPresenter" />
                </Border>

                <!-- Notification peek layer -->
                <Grid x:Name="NotificationLayer"
                      Margin="24,10,24,12"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="NotificationTitleText"
                                   FontFamily="{DynamicResource ShimaFontFamily}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Text="Notification"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="NotificationBodyText"
                                   Margin="0,2,0,0"
                                   FontFamily="{DynamicResource ShimaFontFamily}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextMuted}"
                                   Text="Tap to open or dismiss."
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="NotificationPrimaryActionButton"
                                Margin="0,0,6,0"
                                Style="{StaticResource PillActionButtonStyle}"
                                BorderBrush="{DynamicResource AgentStatusWorkingBrush}"
                                Foreground="{DynamicResource AgentStatusWorkingBrush}"
                                Visibility="Collapsed"
                                Click="OnNotificationPrimaryActionClicked"
                                AutomationProperties.AutomationId="NotificationPrimaryActionButton" />

                        <Button x:Name="NotificationSecondaryActionButton"
                                Margin="0,0,6,0"
                                Style="{StaticResource PillActionButtonStyle}"
                                BorderBrush="{DynamicResource AgentStatusErrorBrush}"
                                Foreground="{DynamicResource AgentStatusErrorBrush}"
                                Visibility="Collapsed"
                                Click="OnNotificationSecondaryActionClicked"
                                AutomationProperties.AutomationId="NotificationSecondaryActionButton" />

                        <Button x:Name="DismissNotificationButton"
                                VerticalAlignment="Center"
                                Style="{StaticResource PillActionButtonStyle}"
                                Content="Dismiss"
                                Click="OnDismissNotificationClicked"
                                AutomationProperties.Name="Dismiss notification"
                                AutomationProperties.AutomationId="DismissNotificationButton" />
                    </StackPanel>
                </Grid>

                <!-- Expanded panel hosting widget carousel -->
                <Grid x:Name="ExpandedLayer"
                      Margin="{DynamicResource IslandExpandedPadding}"
                      Visibility="Collapsed">
                    <shell:WidgetHost x:Name="WidgetHostControl" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
