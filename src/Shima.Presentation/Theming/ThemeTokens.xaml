<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Midnight default palette tokens (spec section 5.3.5) -->
    <Color x:Key="SurfaceCollapsedColor">#FF000000</Color>
    <Color x:Key="SurfaceExpandedColor">#FF000000</Color>
    <Color x:Key="SurfaceElevatedColor">#FF141414</Color>
    <Color x:Key="SurfacePillButtonColor">#FF1E1E22</Color>
    <Color x:Key="SurfacePillButtonHoverColor">#FF2A2A32</Color>
    <Color x:Key="AccentColor">#FFFFFFFF</Color>
    <Color x:Key="BorderHairlineColor">#FF1F1F24</Color>
    <Color x:Key="GlowColor">#73000000</Color>
    <Color x:Key="TextPrimaryColor">#FFF8FAFC</Color>
    <Color x:Key="TextMutedColor">#FF94A3B8</Color>
    <Color x:Key="DotInactiveColor">#4DFFFFFF</Color>
    <Color x:Key="FocusRingColor">#FFFFFFFF</Color>
    <Color x:Key="DropShadowColor">#FF000000</Color>

    <!-- Settings Shell & Modal Surface Tokens -->
    <Color x:Key="SurfaceSettingsWindowColor">#FF0D0E12</Color>
    <Color x:Key="SurfaceSettingsSidebarColor">#FF12141A</Color>
    <Color x:Key="SurfaceSettingsCardColor">#FF171A22</Color>
    <Color x:Key="SurfaceSettingsInputColor">#FF101218</Color>
    <Color x:Key="SettingsBorderSubtleColor">#FF252936</Color>
    <Color x:Key="SettingsNavSelectedColor">#FF202534</Color>
    <Color x:Key="SettingsPrimaryButtonColor">#FF2563EB</Color>
    <Color x:Key="SettingsPrimaryButtonHoverColor">#FF1D4ED8</Color>
    <Color x:Key="SettingsPrimaryButtonTextColor">#FFFFFFFF</Color>
    <Color x:Key="SettingsDangerSurfaceColor">#FF3B151B</Color>
    <Color x:Key="SettingsDangerBorderColor">#FF991B1B</Color>
    <Color x:Key="SettingsDangerTextColor">#FFFCA5A5</Color>

    <!-- Color Picker & Accessibility Advisory Tokens -->
    <Color x:Key="PickerReticleOuterColor">#FFFFFFFF</Color>
    <Color x:Key="PickerReticleInnerColor">#FF0F172A</Color>
    <Color x:Key="WarningBannerSurfaceColor">#FF2E210C</Color>
    <Color x:Key="WarningBannerBorderColor">#FFD97706</Color>
    <Color x:Key="WarningBannerTextColor">#FFFDE68A</Color>

    <!-- Semantic Developer Activity Tokens -->
    <Color x:Key="AgentStatusIdleColor">#FF64748B</Color>
    <Color x:Key="AgentStatusTrackColor">#FF27272A</Color>
    <Color x:Key="AgentStatusWorkingColor">#FF22C55E</Color>
    <Color x:Key="AgentStatusFinishedColor">#FF10B981</Color>
    <Color x:Key="AgentStatusAttentionColor">#FFFB7185</Color>
    <Color x:Key="AgentStatusErrorColor">#FFEF4444</Color>

    <!-- ScrollBar Tokens -->
    <Color x:Key="ScrollBarTrackColor">#00000000</Color>
    <Color x:Key="ScrollBarThumbColor">#5C64748B</Color>
    <Color x:Key="ScrollBarThumbHoverColor">#9994A3B8</Color>
    <Color x:Key="ScrollBarThumbActiveColor">#D9CBD5E1</Color>
    <sys:Double x:Key="ScrollBarSlimSize">6</sys:Double>

    <Thickness x:Key="IslandBorderThickness">1</Thickness>
    <!-- Collapsed & active pill insets account for 12 DIP concave top ears so inner walls have symmetric clearance -->
    <Thickness x:Key="IslandCollapsedOverlayPadding">24,0,24,7</Thickness>
    <Thickness x:Key="IslandActivePillPadding">28,4,28,4</Thickness>
    <!-- Expanded island outer inset (includes 16 DIP concave top-ear offset: 20 DIP left, 18 DIP right, 18 DIP top/bottom inside visible walls) -->
    <Thickness x:Key="IslandExpandedPadding">36,18,34,18</Thickness>

    <!-- Island Surface Brushes -->
    <SolidColorBrush x:Key="SurfaceCollapsed" Color="{DynamicResource SurfaceCollapsedColor}" />
    <SolidColorBrush x:Key="SurfaceExpanded" Color="{DynamicResource SurfaceExpandedColor}" />
    <SolidColorBrush x:Key="SurfaceElevated" Color="{DynamicResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="SurfacePillButton" Color="{DynamicResource SurfacePillButtonColor}" />
    <SolidColorBrush x:Key="SurfacePillButtonHover" Color="{DynamicResource SurfacePillButtonHoverColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="BorderHairline" Color="{DynamicResource BorderHairlineColor}" />
    <SolidColorBrush x:Key="GlowBrush" Color="{DynamicResource GlowColor}" />
    <SolidColorBrush x:Key="TextPrimary" Color="{DynamicResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextMuted" Color="{DynamicResource TextMutedColor}" />
    <SolidColorBrush x:Key="DotInactiveBrush" Color="{DynamicResource DotInactiveColor}" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="{DynamicResource FocusRingColor}" />

    <!-- Settings & Dialog Brushes -->
    <SolidColorBrush x:Key="SurfaceSettingsWindow" Color="{DynamicResource SurfaceSettingsWindowColor}" />
    <SolidColorBrush x:Key="SurfaceSettingsSidebar" Color="{DynamicResource SurfaceSettingsSidebarColor}" />
    <SolidColorBrush x:Key="SurfaceSettingsCard" Color="{DynamicResource SurfaceSettingsCardColor}" />
    <SolidColorBrush x:Key="SurfaceSettingsInput" Color="{DynamicResource SurfaceSettingsInputColor}" />
    <SolidColorBrush x:Key="SettingsBorderSubtle" Color="{DynamicResource SettingsBorderSubtleColor}" />
    <SolidColorBrush x:Key="SettingsNavSelected" Color="{DynamicResource SettingsNavSelectedColor}" />
    <SolidColorBrush x:Key="SettingsPrimaryButton" Color="{DynamicResource SettingsPrimaryButtonColor}" />
    <SolidColorBrush x:Key="SettingsPrimaryButtonHover" Color="{DynamicResource SettingsPrimaryButtonHoverColor}" />
    <SolidColorBrush x:Key="SettingsPrimaryButtonText" Color="{DynamicResource SettingsPrimaryButtonTextColor}" />
    <SolidColorBrush x:Key="SettingsDangerSurface" Color="{DynamicResource SettingsDangerSurfaceColor}" />
    <SolidColorBrush x:Key="SettingsDangerBorder" Color="{DynamicResource SettingsDangerBorderColor}" />
    <SolidColorBrush x:Key="SettingsDangerText" Color="{DynamicResource SettingsDangerTextColor}" />

    <!-- Color Picker & Semantic Brushes -->
    <SolidColorBrush x:Key="PickerReticleOuterBrush" Color="{DynamicResource PickerReticleOuterColor}" />
    <SolidColorBrush x:Key="PickerReticleInnerBrush" Color="{DynamicResource PickerReticleInnerColor}" />
    <SolidColorBrush x:Key="WarningBannerSurface" Color="{DynamicResource WarningBannerSurfaceColor}" />
    <SolidColorBrush x:Key="WarningBannerBorder" Color="{DynamicResource WarningBannerBorderColor}" />
    <SolidColorBrush x:Key="WarningBannerText" Color="{DynamicResource WarningBannerTextColor}" />
    <SolidColorBrush x:Key="AgentStatusIdleBrush" Color="{DynamicResource AgentStatusIdleColor}" />
    <SolidColorBrush x:Key="AgentStatusTrackBrush" Color="{DynamicResource AgentStatusTrackColor}" />
    <SolidColorBrush x:Key="AgentStatusWorkingBrush" Color="{DynamicResource AgentStatusWorkingColor}" />
    <SolidColorBrush x:Key="AgentStatusFinishedBrush" Color="{DynamicResource AgentStatusFinishedColor}" />
    <SolidColorBrush x:Key="AgentStatusAttentionBrush" Color="{DynamicResource AgentStatusAttentionColor}" />
    <SolidColorBrush x:Key="AgentStatusErrorBrush" Color="{DynamicResource AgentStatusErrorColor}" />

    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{DynamicResource ScrollBarTrackColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{DynamicResource ScrollBarThumbColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{DynamicResource ScrollBarThumbHoverColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbActiveBrush" Color="{DynamicResource ScrollBarThumbActiveColor}" />

    <FontFamily x:Key="ShimaFontFamily">Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- Global Minimalist Pill ScrollBar Templates & Implicit Style -->
    <Style x:Key="ShimaScrollBarPageButtonStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ShimaScrollBarThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="{DynamicResource ScrollBarThumbBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="ThumbPill"
                            CornerRadius="3"
                            Background="{TemplateBinding Background}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbPill" Property="Background" Value="{DynamicResource ScrollBarThumbHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbPill" Property="Background" Value="{DynamicResource ScrollBarThumbActiveBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ThumbPill" Property="Opacity" Value="0.25" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="ShimaVerticalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Grid x:Name="Bg" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ShimaScrollBarPageButtonStyle}"
                                  Command="ScrollBar.PageUpCommand" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ShimaScrollBarThumbStyle}" MinHeight="18" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ShimaScrollBarPageButtonStyle}"
                                  Command="ScrollBar.PageDownCommand" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="ShimaHorizontalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Grid x:Name="Bg" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ShimaScrollBarPageButtonStyle}"
                                  Command="ScrollBar.PageLeftCommand" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ShimaScrollBarThumbStyle}" MinWidth="18" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ShimaScrollBarPageButtonStyle}"
                                  Command="ScrollBar.PageRightCommand" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ScrollBarTrackBrush}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="{DynamicResource ScrollBarSlimSize}" />
                <Setter Property="MinWidth" Value="{DynamicResource ScrollBarSlimSize}" />
                <Setter Property="Height" Value="Auto" />
                <Setter Property="Template" Value="{StaticResource ShimaVerticalScrollBarTemplate}" />
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="{DynamicResource ScrollBarSlimSize}" />
                <Setter Property="MinHeight" Value="{DynamicResource ScrollBarSlimSize}" />
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Template" Value="{StaticResource ShimaHorizontalScrollBarTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
