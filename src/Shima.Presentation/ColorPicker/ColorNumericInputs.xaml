<UserControl x:Class="Shima.Presentation.ColorPicker.ColorNumericInputs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="NumericFieldBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceSettingsInput}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsBorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontFamily" Value="{DynamicResource ShimaFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Hex Input -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Hex"
                       VerticalAlignment="Center"
                       FontFamily="{DynamicResource ShimaFontFamily}"
                       FontSize="12"
                       Foreground="{DynamicResource TextMuted}" />
            <TextBox x:Name="HexInputBox"
                     Grid.Column="1"
                     Style="{StaticResource NumericFieldBoxStyle}"
                     MaxLength="9"
                     KeyDown="OnInputKeyDown"
                     LostFocus="OnHexLostFocus"
                     TextChanged="OnHexTextChanged"
                     AutomationProperties.Name="Hex color input"
                     AutomationProperties.AutomationId="HexInputBox" />
        </Grid>

        <!-- HSB Channels -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="HSB"
                       VerticalAlignment="Center"
                       FontFamily="{DynamicResource ShimaFontFamily}"
                       FontSize="12"
                       Foreground="{DynamicResource TextMuted}" />
            <TextBox x:Name="HueInputBox"
                     Grid.Column="1"
                     Style="{StaticResource NumericFieldBoxStyle}"
                     ToolTip="Hue (0-360°)"
                     KeyDown="OnInputKeyDown"
                     LostFocus="OnHsbLostFocus"
                     AutomationProperties.Name="Hue channel degrees"
                     AutomationProperties.AutomationId="HueInputBox" />
            <TextBox x:Name="SaturationInputBox"
                     Grid.Column="3"
                     Style="{StaticResource NumericFieldBoxStyle}"
                     ToolTip="Saturation (0-100%)"
                     KeyDown="OnInputKeyDown"
                     LostFocus="OnHsbLostFocus"
                     AutomationProperties.Name="Saturation channel percent"
                     AutomationProperties.AutomationId="SaturationInputBox" />
            <TextBox x:Name="BrightnessInputBox"
                     Grid.Column="5"
                     Style="{StaticResource NumericFieldBoxStyle}"
                     ToolTip="Brightness (0-100%)"
                     KeyDown="OnInputKeyDown"
                     LostFocus="OnHsbLostFocus"
                     AutomationProperties.Name="Brightness channel percent"
                     AutomationProperties.AutomationId="BrightnessInputBox" />
        </Grid>

        <!-- RGB Channels -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="RGB"
                       VerticalAlignment="Center"
                       FontFamily="{DynamicResource ShimaFontFamily}"
                       FontSize="12"
                       Foreground="{DynamicResource TextMuted}" />
            <TextBox x:Name="RedInputBox"
                     Grid.Column="1"
                     Style="{StaticResource NumericFieldBoxStyle}"
                     ToolTip="Red (0-255)"
                     KeyDown="OnInputKeyDown"
                     LostFocus="OnRgbLostFocus"
                     AutomationProperties.Name="Red channel value"
                     AutomationProperties.AutomationId="RedInputBox" />
            <TextBox x:Name="GreenInputBox"
                     Grid.Column="3"
                     Style="{StaticResource NumericFieldBoxStyle}"
                     ToolTip="Green (0-255)"
                     KeyDown="OnInputKeyDown"
                     LostFocus="OnRgbLostFocus"
                     AutomationProperties.Name="Green channel value"
                     AutomationProperties.AutomationId="GreenInputBox" />
            <TextBox x:Name="BlueInputBox"
                     Grid.Column="5"
                     Style="{StaticResource NumericFieldBoxStyle}"
                     ToolTip="Blue (0-255)"
                     KeyDown="OnInputKeyDown"
                     LostFocus="OnRgbLostFocus"
                     AutomationProperties.Name="Blue channel value"
                     AutomationProperties.AutomationId="BlueInputBox" />
        </Grid>

        <TextBlock x:Name="ValidationHintText"
                   Margin="0,6,0,0"
                   FontFamily="{DynamicResource ShimaFontFamily}"
                   FontSize="11"
                   Foreground="{DynamicResource WarningBannerText}"
                   Visibility="Collapsed"
                   AutomationProperties.Name="Color input validation hint" />
    </StackPanel>
</UserControl>
