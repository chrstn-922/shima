<UserControl x:Class="Shima.Presentation.ColorPicker.ColorPreviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <StackPanel>
        <TextBlock Text="Color comparison"
                   FontFamily="{DynamicResource ShimaFontFamily}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}"
                   Margin="0,0,0,8" />

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="OriginalSwatchButton"
                    Grid.Column="0"
                    Cursor="Hand"
                    Click="OnOriginalSwatchClicked"
                    AutomationProperties.Name="Revert to original color"
                    AutomationProperties.AutomationId="RevertOriginalSwatchButton">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardRoot"
                                Background="{DynamicResource SurfaceSettingsInput}"
                                BorderBrush="{DynamicResource SettingsBorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8">
                            <StackPanel>
                                <Border x:Name="OriginalSwatchBorder"
                                        Height="28"
                                        CornerRadius="5"
                                        Background="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=OriginalBrush}"
                                        BorderBrush="{DynamicResource SettingsBorderSubtle}"
                                        BorderThickness="1"
                                        AutomationProperties.Name="Original committed color swatch"
                                        AutomationProperties.AutomationId="OriginalColorSwatch" />
                                <TextBlock Text="Original (revert)"
                                           FontFamily="{DynamicResource ShimaFontFamily}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMuted}"
                                           Margin="0,6,0,0" />
                                <TextBlock x:Name="OriginalHexLabel"
                                           Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=OriginalHex}"
                                           FontFamily="{DynamicResource ShimaFontFamily}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CardRoot" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
                                <Setter TargetName="CardRoot" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Border Grid.Column="2"
                    Background="{DynamicResource SurfaceSettingsInput}"
                    BorderBrush="{DynamicResource SettingsBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8">
                <StackPanel>
                    <Border x:Name="CurrentSwatchBorder"
                            Height="28"
                            CornerRadius="5"
                            BorderBrush="{DynamicResource SettingsBorderSubtle}"
                            BorderThickness="1"
                            AutomationProperties.Name="Live preview color swatch"
                            AutomationProperties.AutomationId="LivePreviewColorSwatch" />
                    <TextBlock Text="Preview"
                               FontFamily="{DynamicResource ShimaFontFamily}"
                               FontSize="11"
                               Foreground="{DynamicResource TextMuted}"
                               Margin="0,6,0,0" />
                    <TextBlock x:Name="CurrentHexLabel"
                               FontFamily="{DynamicResource ShimaFontFamily}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Text="Recent colors"
                   FontFamily="{DynamicResource ShimaFontFamily}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}"
                   Margin="0,0,0,6" />

        <ItemsControl x:Name="RecentColorsItemsControl"
                      AutomationProperties.Name="Recent colors palette"
                      AutomationProperties.AutomationId="RecentColorsList">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="6" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Margin="0,0,6,6"
                            Width="24"
                            Height="24"
                            Cursor="Hand"
                            Click="OnRecentSwatchClicked"
                            Tag="{Binding Hex}"
                            ToolTip="{Binding Hex}"
                            AutomationProperties.Name="{Binding AccessibleActionName}"
                            AutomationProperties.AutomationId="{Binding AutomationId}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="SwatchBox"
                                        Background="{Binding SwatchBrush}"
                                        BorderBrush="{DynamicResource SettingsBorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="6" />
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="SwatchBox" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
                                        <Setter TargetName="SwatchBox" Property="BorderThickness" Value="2" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="NoRecentsText"
                   Text="No recent custom colors yet"
                   FontFamily="{DynamicResource ShimaFontFamily}"
                   FontSize="11"
                   Foreground="{DynamicResource TextMuted}"
                   Visibility="Collapsed" />
    </StackPanel>
</UserControl>
