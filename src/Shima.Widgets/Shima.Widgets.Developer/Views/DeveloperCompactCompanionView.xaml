<UserControl x:Class="Shima.Widgets.Developer.Views.DeveloperCompactCompanionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dev="clr-namespace:Shima.Widgets.Developer"
             Focusable="False"
             AutomationProperties.Name="{Binding BarAccessibleStatus}"
             AutomationProperties.AutomationId="DeveloperCompactCompanionView">
    <UserControl.Resources>
        <Style x:Key="CompanionAgentDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="5" />
            <Setter Property="Height" Value="5" />
            <Setter Property="Fill" Value="{DynamicResource AgentStatusWorkingBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding BarVisualState}" Value="{x:Static dev:DeveloperBarVisualState.Finished}">
                    <Setter Property="Fill" Value="{DynamicResource AgentStatusFinishedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BarVisualState}" Value="{x:Static dev:DeveloperBarVisualState.Attention}">
                    <Setter Property="Fill" Value="{DynamicResource AgentStatusAttentionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BarVisualState}" Value="{x:Static dev:DeveloperBarVisualState.ErrorFailed}">
                    <Setter Property="Fill" Value="{DynamicResource AgentStatusErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CompanionAgentBarStyle" TargetType="ProgressBar">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="4" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="{DynamicResource AgentStatusTrackBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AgentStatusWorkingBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border x:Name="PART_Track"
                                Height="4"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2">
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Height="4"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="2" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding BarVisualState}" Value="{x:Static dev:DeveloperBarVisualState.Idle}">
                    <Setter Property="Foreground" Value="{DynamicResource AgentStatusIdleBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BarVisualState}" Value="{x:Static dev:DeveloperBarVisualState.Working}">
                    <Setter Property="Foreground" Value="{DynamicResource AgentStatusWorkingBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BarVisualState}" Value="{x:Static dev:DeveloperBarVisualState.Attention}">
                    <Setter Property="Foreground" Value="{DynamicResource AgentStatusAttentionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BarVisualState}" Value="{x:Static dev:DeveloperBarVisualState.Finished}">
                    <Setter Property="Foreground" Value="{DynamicResource AgentStatusFinishedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BarVisualState}" Value="{x:Static dev:DeveloperBarVisualState.ErrorFailed}">
                    <Setter Property="Foreground" Value="{DynamicResource AgentStatusErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Height="20"
            Padding="6,0"
            CornerRadius="10"
            Background="{DynamicResource SurfacePillButton}"
            BorderBrush="{DynamicResource BorderHairline}"
            BorderThickness="1"
            VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Style="{StaticResource CompanionAgentDotStyle}"
                     Margin="0,0,5,0"
                     VerticalAlignment="Center" />
            <ProgressBar x:Name="CompanionProgressBar"
                         Style="{StaticResource CompanionAgentBarStyle}"
                         Value="{Binding BarFillPercent, Mode=OneWay}"
                         VerticalAlignment="Center"
                         AutomationProperties.AutomationId="DeveloperCompanionProgressBar" />
        </StackPanel>
    </Border>
</UserControl>
