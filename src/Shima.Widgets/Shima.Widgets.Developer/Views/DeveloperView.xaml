<UserControl x:Class="Shima.Widgets.Developer.Views.DeveloperView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dev="clr-namespace:Shima.Widgets.Developer"
             AutomationProperties.Name="{Binding AccessibleStatus}"
             AutomationProperties.AutomationId="DeveloperWidgetView">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="DevSummaryBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="{DynamicResource AgentStatusTrackBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AgentStatusIdleBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border x:Name="PART_Track"
                                Height="4"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2">
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Height="4"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="2" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding BarVisualState}" Value="{x:Static dev:DeveloperBarVisualState.Idle}">
                    <Setter Property="Foreground" Value="{DynamicResource AgentStatusIdleBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BarVisualState}" Value="{x:Static dev:DeveloperBarVisualState.Working}">
                    <Setter Property="Foreground" Value="{DynamicResource AgentStatusWorkingBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BarVisualState}" Value="{x:Static dev:DeveloperBarVisualState.Attention}">
                    <Setter Property="Foreground" Value="{DynamicResource AgentStatusAttentionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BarVisualState}" Value="{x:Static dev:DeveloperBarVisualState.Finished}">
                    <Setter Property="Foreground" Value="{DynamicResource AgentStatusFinishedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BarVisualState}" Value="{x:Static dev:DeveloperBarVisualState.ErrorFailed}">
                    <Setter Property="Foreground" Value="{DynamicResource AgentStatusErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DevPillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfacePillButton}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontFamily" Value="{DynamicResource ShimaFontFamily}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource SurfacePillButtonHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
                                <Setter TargetName="BtnBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DevAllowButtonStyle" TargetType="Button" BasedOn="{StaticResource DevPillButtonStyle}">
            <Setter Property="BorderBrush" Value="{DynamicResource AgentStatusWorkingBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AgentStatusWorkingBrush}" />
        </Style>

        <Style x:Key="DevDenyButtonStyle" TargetType="Button" BasedOn="{StaticResource DevPillButtonStyle}">
            <Setter Property="BorderBrush" Value="{DynamicResource AgentStatusErrorBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AgentStatusErrorBrush}" />
        </Style>

        <Style x:Key="RowStatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource ShimaFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKey}" Value="Working">
                    <Setter Property="Foreground" Value="{DynamicResource AgentStatusWorkingBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="NeedsAttention">
                    <Setter Property="Foreground" Value="{DynamicResource AgentStatusAttentionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="AwaitingApproval">
                    <Setter Property="Foreground" Value="{DynamicResource AgentStatusAttentionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="Finished">
                    <Setter Property="Foreground" Value="{DynamicResource AgentStatusFinishedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="ErrorFailed">
                    <Setter Property="Foreground" Value="{DynamicResource AgentStatusErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Pinned Summary Status Bar -->
        <ProgressBar Grid.Row="0"
                     Style="{StaticResource DevSummaryBarStyle}"
                     Value="{Binding BarFillPercent, Mode=OneWay}"
                     AutomationProperties.Name="{Binding BarAccessibleStatus}"
                     AutomationProperties.AutomationId="DeveloperExpandedSummaryBar" />

        <!-- Compact Header -->
        <DockPanel Grid.Row="2" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Developer Activity"
                           FontFamily="{DynamicResource ShimaFontFamily}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="{Binding HeaderStatusSummary}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="{DynamicResource ShimaFontFamily}"
                           FontSize="11"
                           Foreground="{DynamicResource TextMuted}" />
            </StackPanel>

            <Button DockPanel.Dock="Right"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{DynamicResource TextMuted}"
                    Padding="4,1"
                    FontFamily="{DynamicResource ShimaFontFamily}"
                    FontSize="13"
                    Cursor="Hand"
                    Content="&#x2699;"
                    Click="OnSettingsClicked"
                    AutomationProperties.Name="Open Developer Integrations settings"
                    AutomationProperties.AutomationId="DeveloperSettingsGearButton" />
        </DockPanel>

        <!-- Empty State or Multi-Session List -->
        <Grid Grid.Row="4">
            <TextBlock Text="{Binding EmptyStateLabel}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                       FontFamily="{DynamicResource ShimaFontFamily}"
                       FontSize="11.5"
                       Foreground="{DynamicResource TextMuted}"
                       VerticalAlignment="Top"
                       AutomationProperties.AutomationId="DeveloperEmptyStateText" />

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Sessions}"
                              AutomationProperties.AutomationId="DeveloperSessionsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceElevated}"
                                    BorderBrush="{DynamicResource BorderHairline}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8,6"
                                    Margin="0,0,0,6"
                                    Tag="{Binding SessionId}"
                                    MouseLeftButtonUp="OnSessionRowMouseUp"
                                    AutomationProperties.Name="{Binding RowAutomationName}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Agent Badge (24x24 DIP) -->
                                        <Border Grid.Column="0"
                                                Width="24"
                                                Height="24"
                                                CornerRadius="6"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource SurfacePillButton}"
                                                BorderBrush="{DynamicResource AccentBrush}"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding AdapterBadgeText}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{DynamicResource ShimaFontFamily}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>

                                        <!-- Bold Task Title + Muted Repo Subtitle -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding TaskTitle}"
                                                       FontFamily="{DynamicResource ShimaFontFamily}"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding RepositorySubtitle}"
                                                       FontFamily="{DynamicResource ShimaFontFamily}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Right-Aligned Color-Coded State + Tabular Elapsed/Relative Time + Dismiss -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusLabel}"
                                                           Style="{StaticResource RowStatusTextStyle}" />
                                                <TextBlock Text="{Binding TimestampLabel}"
                                                           HorizontalAlignment="Right"
                                                           FontFamily="{DynamicResource ShimaFontFamily}"
                                                           FontSize="10.5"
                                                           Typography.NumeralAlignment="Tabular"
                                                           Foreground="{DynamicResource TextMuted}" />
                                            </StackPanel>

                                            <Button Content="&#x00D7;"
                                                    Margin="6,0,0,0"
                                                    Padding="5,1"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="{DynamicResource TextMuted}"
                                                    FontSize="12"
                                                    Cursor="Hand"
                                                    Tag="{Binding SessionId}"
                                                    Visibility="{Binding CanDismiss, Converter={StaticResource BoolToVis}}"
                                                    Click="OnDismissSessionClicked"
                                                    AutomationProperties.Name="{Binding DismissAutomationName}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Conditional Detail + Strictly Actionable Single-Action Allow/Deny Controls -->
                                    <DockPanel Grid.Row="1"
                                               Margin="32,4,0,0"
                                               LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right"
                                                    Orientation="Horizontal"
                                                    Visibility="{Binding ShowApprovalButtons, Converter={StaticResource BoolToVis}}">
                                            <Button Content="Allow"
                                                    Style="{StaticResource DevAllowButtonStyle}"
                                                    Margin="6,0,4,0"
                                                    Tag="{Binding}"
                                                    Click="OnAllowClicked"
                                                    AutomationProperties.Name="{Binding AllowAutomationName}" />
                                            <Button Content="Deny"
                                                    Style="{StaticResource DevDenyButtonStyle}"
                                                    Tag="{Binding}"
                                                    Click="OnDenyClicked"
                                                    AutomationProperties.Name="{Binding DenyAutomationName}" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding DetailText}"
                                                   Visibility="{Binding HasPendingDetail, Converter={StaticResource BoolToVis}}"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{DynamicResource ShimaFontFamily}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
