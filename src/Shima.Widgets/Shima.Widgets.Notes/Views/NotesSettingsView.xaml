<UserControl x:Class="Shima.Widgets.Notes.Views.NotesSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Notes widget settings">
    <UserControl.Resources>
        <Style x:Key="NotesSettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceSettingsCard}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsBorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="NotesSettingsButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceSettingsInput}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsBorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontFamily" Value="{DynamicResource ShimaFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource SettingsNavSelected}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
                                <Setter TargetName="BtnBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Border Style="{StaticResource NotesSettingsCardStyle}">
            <StackPanel>
                <DockPanel LastChildFill="False" Margin="0,0,0,10">
                    <TextBlock DockPanel.Dock="Left"
                               Text="Scratchpad notes"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource ShimaFontFamily}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" />

                    <Button DockPanel.Dock="Right"
                            Content="Reset defaults"
                            Style="{StaticResource NotesSettingsButtonStyle}"
                            Click="OnResetDefaultsClicked"
                            AutomationProperties.AutomationId="NotesResetDefaultsButton" />
                </DockPanel>

                <CheckBox x:Name="ShowWordCountCheck"
                          Content="Show word and character count in scratchpad toolbar"
                          IsChecked="{Binding ShowWordCount, Mode=OneWay}"
                          Foreground="{DynamicResource TextPrimary}"
                          Checked="OnOptionToggled"
                          Unchecked="OnOptionToggled"
                          AutomationProperties.AutomationId="NotesShowWordCountCheck" />

                <TextBlock Margin="22,6,0,0"
                           FontFamily="{DynamicResource ShimaFontFamily}"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextMuted}"
                           TextWrapping="Wrap"
                           Text="Notes auto-save locally within 500 ms to your encrypted user profile folder (200 KB max per note)." />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
