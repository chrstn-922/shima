<UserControl x:Class="Shima.Widgets.Clock.Views.ClockSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Clock widget settings">
    <UserControl.Resources>
        <Style x:Key="ClockSettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceSettingsCard}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsBorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="ClockSettingsButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceSettingsInput}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsBorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontFamily" Value="{DynamicResource ShimaFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource SettingsNavSelected}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
                                <Setter TargetName="BtnBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClockSearchBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceSettingsInput}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsBorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontFamily" Value="{DynamicResource ShimaFontFamily}" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Time Format Preferences -->
        <Border Style="{StaticResource ClockSettingsCardStyle}">
            <StackPanel>
                <TextBlock Text="Time display format"
                           FontFamily="{DynamicResource ShimaFontFamily}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="0,0,0,10" />

                <CheckBox x:Name="Use24HourCheck"
                          Content="Use 24-hour clock format"
                          IsChecked="{Binding Use24HourFormat, Mode=OneWay}"
                          Foreground="{DynamicResource TextPrimary}"
                          Margin="0,0,0,8"
                          Checked="OnFormatToggled"
                          Unchecked="OnFormatToggled"
                          AutomationProperties.AutomationId="ClockUse24HourCheck" />

                <CheckBox x:Name="ShowSecondsCheck"
                          Content="Display seconds on active readout"
                          IsChecked="{Binding ShowSeconds, Mode=OneWay}"
                          Foreground="{DynamicResource TextPrimary}"
                          Checked="OnFormatToggled"
                          Unchecked="OnFormatToggled"
                          AutomationProperties.AutomationId="ClockShowSecondsCheck" />
            </StackPanel>
        </Border>

        <!-- Configured Cities -->
        <Border Style="{StaticResource ClockSettingsCardStyle}">
            <StackPanel>
                <DockPanel LastChildFill="False" Margin="0,0,0,10">
                    <TextBlock DockPanel.Dock="Left"
                               Text="Configured world cities"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource ShimaFontFamily}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" />

                    <Button DockPanel.Dock="Right"
                            Content="Reset defaults"
                            Style="{StaticResource ClockSettingsButtonStyle}"
                            Click="OnResetDefaultsClicked"
                            AutomationProperties.AutomationId="ClockResetDefaultsButton" />
                </DockPanel>

                <ItemsControl ItemsSource="{Binding Locations}"
                              AutomationProperties.AutomationId="ClockConfiguredCitiesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayBulletName}"
                                               FontFamily="{DynamicResource ShimaFontFamily}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="{Binding UtcOffsetLabel}"
                                               FontFamily="{DynamicResource ShimaFontFamily}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMuted}" />
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <TextBlock Text="{Binding CompactTimeText}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"
                                               FontFamily="{DynamicResource ShimaFontFamily}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMuted}" />
                                    <Button Style="{StaticResource ClockSettingsButtonStyle}"
                                            Content="Primary"
                                            Tag="{Binding LocationId}"
                                            Margin="0,0,6,0"
                                            Click="OnSetPrimaryClicked" />
                                    <Button Style="{StaticResource ClockSettingsButtonStyle}"
                                            Content="Up"
                                            Tag="{Binding LocationId}"
                                            IsEnabled="{Binding CanMoveUp}"
                                            Margin="0,0,6,0"
                                            Click="OnMoveUpClicked" />
                                    <Button Style="{StaticResource ClockSettingsButtonStyle}"
                                            Content="Down"
                                            Tag="{Binding LocationId}"
                                            IsEnabled="{Binding CanMoveDown}"
                                            Margin="0,0,6,0"
                                            Click="OnMoveDownClicked" />
                                    <Button Style="{StaticResource ClockSettingsButtonStyle}"
                                            Content="Remove"
                                            Tag="{Binding LocationId}"
                                            IsEnabled="{Binding CanRemove}"
                                            Click="OnRemoveCityClicked" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Searchable Offline Timezone Catalog -->
        <Border Style="{StaticResource ClockSettingsCardStyle}">
            <StackPanel>
                <TextBlock Text="Add world city or timezone"
                           FontFamily="{DynamicResource ShimaFontFamily}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="0,0,0,8" />

                <TextBox x:Name="CatalogSearchBox"
                         Style="{StaticResource ClockSearchBoxStyle}"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,10"
                         ToolTip="Search by city, country, or IANA/Windows timezone"
                         AutomationProperties.Name="Search world cities and timezones"
                         AutomationProperties.AutomationId="ClockCatalogSearchBox" />

                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding CatalogMatches}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,6" LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayLabel}"
                                                   FontFamily="{DynamicResource ShimaFontFamily}"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="{Binding IanaTzId}"
                                                   FontFamily="{DynamicResource ShimaFontFamily}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMuted}" />
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource ClockSettingsButtonStyle}"
                                            Content="Add"
                                            Tag="{Binding}"
                                            Click="OnAddCatalogCityClicked" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
