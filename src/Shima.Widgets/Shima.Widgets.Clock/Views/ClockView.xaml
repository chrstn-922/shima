<UserControl x:Class="Shima.Widgets.Clock.Views.ClockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="{Binding AccessibleStatus}"
             AutomationProperties.AutomationId="ClockWidgetView">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="CityItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ItemRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1.5"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource SurfacePillButton}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ItemRoot" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClockGearButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="GearBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1.5"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GearBorder" Property="Background" Value="{DynamicResource SurfacePillButtonHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="GearBorder" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="62*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="38*" />
        </Grid.ColumnDefinitions>

        <!-- Left Column: Date, Oversized HeroMetric Time + AM/PM, City · UTC+Offset -->
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock x:Name="ClockDateText"
                       Text="{Binding DateText}"
                       FontFamily="{DynamicResource ShimaFontFamily}"
                       FontSize="11.5"
                       Foreground="{DynamicResource TextMuted}"
                       TextTrimming="CharacterEllipsis"
                       AutomationProperties.AutomationId="ClockDateText" />

            <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                <TextBlock x:Name="ClockTimeText"
                           Text="{Binding TimeText}"
                           FontFamily="{DynamicResource ShimaFontFamily}"
                           FontSize="40"
                           FontWeight="Light"
                           Typography.NumeralAlignment="Tabular"
                           LineHeight="44"
                           Foreground="{DynamicResource TextPrimary}"
                           AutomationProperties.AutomationId="ClockTimeText" />
                <TextBlock x:Name="ClockAmPmText"
                           Text="{Binding AmPmText}"
                           Visibility="{Binding HasAmPm, Converter={StaticResource BoolToVis}}"
                           FontFamily="{DynamicResource ShimaFontFamily}"
                           FontSize="11"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Top"
                           Margin="4,7,0,0"
                           AutomationProperties.AutomationId="ClockAmPmText" />
            </StackPanel>

            <TextBlock x:Name="ClockLocationSubtitleText"
                       Text="{Binding LocationSubtitle}"
                       FontFamily="{DynamicResource ShimaFontFamily}"
                       FontSize="11.5"
                       Foreground="{DynamicResource TextMuted}"
                       TextTrimming="CharacterEllipsis"
                       AutomationProperties.AutomationId="ClockLocationSubtitleText" />
        </StackPanel>

        <!-- Right Column: Scrollable World City List + Bottom Settings Gear -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalAlignment="Center">
                <ItemsControl x:Name="WorldCitiesItemsControl"
                              ItemsSource="{Binding Locations}"
                              AutomationProperties.Name="World cities list"
                              AutomationProperties.AutomationId="ClockCitiesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CityItemButtonStyle}"
                                    Click="OnCityClicked"
                                    Tag="{Binding LocationId}"
                                    AutomationProperties.Name="{Binding SwitchActionLabel}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="4"
                                             Height="4"
                                             Margin="0,0,6,0"
                                             VerticalAlignment="Center"
                                             Fill="{DynamicResource AccentBrush}"
                                             Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock x:Name="CityLabel"
                                               Text="{Binding CityName}"
                                               FontFamily="{DynamicResource ShimaFontFamily}"
                                               FontSize="11.5"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextMuted}" />
                                </StackPanel>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                    <Setter TargetName="CityLabel" Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                    <Setter TargetName="CityLabel" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button x:Name="SettingsGearButton"
                    Grid.Row="1"
                    HorizontalAlignment="Right"
                    Margin="0,2,0,0"
                    Style="{StaticResource ClockGearButtonStyle}"
                    Content="&#x2699;"
                    FontSize="13"
                    Click="OnSettingsGearClicked"
                    ToolTip="Open Clock settings"
                    AutomationProperties.Name="Open Clock settings"
                    AutomationProperties.AutomationId="ClockOpenSettingsButton" />
        </Grid>
    </Grid>
</UserControl>
