<UserControl x:Class="Shima.Widgets.FocusTimer.Views.FocusTimerCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="{Binding AccessibleStatus}"
             AutomationProperties.AutomationId="FocusTimerCompactView">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
            <Ellipse Width="7"
                     Height="7"
                     VerticalAlignment="Center"
                     Margin="0,0,6,0"
                     Fill="{DynamicResource AccentBrush}" />
            <TextBlock Text="{Binding CompactPhaseShortLabel}"
                       VerticalAlignment="Center"
                       FontFamily="{DynamicResource ShimaFontFamily}"
                       FontSize="11"
                       FontWeight="Medium"
                       Foreground="{DynamicResource TextMuted}" />
        </StackPanel>

        <TextBlock Grid.Column="1"
                   Text="{Binding CountdownDisplay}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   FontFamily="{DynamicResource ShimaFontFamily}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Typography.NumeralAlignment="Tabular"
                   Foreground="{DynamicResource TextPrimary}" />

        <Ellipse Grid.Column="2"
                 Width="5"
                 Height="5"
                 Margin="8,0,0,0"
                 VerticalAlignment="Center"
                 Fill="{DynamicResource AgentStatusWorkingBrush}"
                 Visibility="{Binding HasActiveZenEffects, Converter={StaticResource BoolToVis}}" />
    </Grid>
</UserControl>
