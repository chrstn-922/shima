<UserControl x:Class="Shima.Widgets.NowPlaying.Views.NowPlayingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="{Binding AccessibleStatus}"
             AutomationProperties.AutomationId="NowPlayingWidgetView">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="TransportIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1.5"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource SurfacePillButtonHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
                                <Setter TargetName="BtnBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryPlayButtonStyle" TargetType="Button" BasedOn="{StaticResource TransportIconButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="{DynamicResource SurfacePillButton}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style x:Key="MediaSeekSliderStyle" TargetType="Slider">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="18" Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4"
                                                        CornerRadius="2"
                                                        Background="{DynamicResource AccentBrush}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4"
                                                        CornerRadius="2"
                                                        Background="{DynamicResource AgentStatusTrackBrush}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="10" Height="10">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource TextPrimary}"
                                                         Stroke="{DynamicResource AccentBrush}"
                                                         StrokeThickness="1.5" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Active Media View -->
        <Grid Visibility="{Binding HasSession, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Row: Artwork + Track Metadata + Transport Controls -->
            <Grid Grid.Row="0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 64x64 Rounded Album Artwork with Vector Note Fallback -->
                <Border Grid.Column="0"
                        Width="64"
                        Height="64"
                        CornerRadius="12"
                        Background="{DynamicResource SurfaceElevated}"
                        BorderBrush="{DynamicResource BorderHairline}"
                        BorderThickness="1"
                        ClipToBounds="True">
                    <Grid>
                        <Path Data="M11,3 L11,14.5 C10.4,14.2 9.7,14 9,14 C7.1,14 5.5,15.3 5.5,17 C5.5,18.7 7.1,20 9,20 C10.9,20 12.5,18.7 12.5,17 L12.5,7 L18,5.8 L18,12.5 C17.4,12.2 16.7,12 16,12 C14.1,12 12.5,13.3 12.5,15 C12.5,16.7 14.1,18 16,18 C17.9,18 19.5,16.7 19.5,15 L19.5,1.5 L11,3 Z"
                              Fill="{DynamicResource TextMuted}"
                              Width="22"
                              Height="22"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />

                        <Image Source="{Binding ArtworkBitmap}"
                               Stretch="UniformToFill"
                               Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVis}}"
                               AutomationProperties.Name="Album artwork" />
                    </Grid>
                </Border>

                <!-- Title / Artist / Playback State -->
                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <TextBlock Text="{Binding Title}"
                               FontFamily="{DynamicResource ShimaFontFamily}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.AutomationId="NowPlayingTitleText" />
                    <TextBlock Text="{Binding ArtistSubtitle}"
                               Margin="0,2,0,0"
                               FontFamily="{DynamicResource ShimaFontFamily}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMuted}"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.AutomationId="NowPlayingArtistText" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Ellipse Width="6"
                                 Height="6"
                                 Margin="0,0,6,0"
                                 VerticalAlignment="Center"
                                 Fill="{DynamicResource AccentBrush}"
                                 Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding StatusLabel}"
                                   FontFamily="{DynamicResource ShimaFontFamily}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMuted}" />
                    </StackPanel>
                </StackPanel>

                <!-- Previous / Play-Pause / Next -->
                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="PreviousButton"
                            Style="{StaticResource TransportIconButtonStyle}"
                            IsEnabled="{Binding CanSkipPrevious}"
                            Click="OnPreviousClicked"
                            Margin="0,0,4,0"
                            ToolTip="Previous track"
                            AutomationProperties.Name="Previous track"
                            AutomationProperties.AutomationId="NowPlayingPrevButton">
                        <Path Data="M4,4 H6 V14 H4 Z M15,4 L7,9 L15,14 Z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="12"
                              Height="12"
                              Stretch="Uniform" />
                    </Button>

                    <Button x:Name="PlayPauseButton"
                            Style="{StaticResource PrimaryPlayButtonStyle}"
                            IsEnabled="{Binding CanPlayPause}"
                            Click="OnPlayPauseClicked"
                            Margin="0,0,4,0"
                            ToolTip="{Binding PlayPauseActionLabel}"
                            AutomationProperties.Name="{Binding PlayPauseActionLabel}"
                            AutomationProperties.AutomationId="NowPlayingPlayPauseButton">
                        <Grid Width="12" Height="12">
                            <Path x:Name="PlayGlyph"
                                  Data="M2,1 L11,6 L2,11 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <Path x:Name="PauseGlyph"
                                  Data="M2,1 H5 V11 H2 Z M8,1 H11 V11 H8 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform"
                                  Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Button>

                    <Button x:Name="NextButton"
                            Style="{StaticResource TransportIconButtonStyle}"
                            IsEnabled="{Binding CanSkipNext}"
                            Click="OnNextClicked"
                            ToolTip="Next track"
                            AutomationProperties.Name="Next track"
                            AutomationProperties.AutomationId="NowPlayingNextButton">
                        <Path Data="M3,4 L11,9 L3,14 Z M12,4 H14 V14 H12 Z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="12"
                              Height="12"
                              Stretch="Uniform" />
                    </Button>

                    <Button x:Name="SettingsGearButton"
                            Style="{StaticResource TransportIconButtonStyle}"
                            Width="24"
                            Height="24"
                            Margin="4,0,0,0"
                            Foreground="{DynamicResource TextMuted}"
                            Content="&#x2699;"
                            FontSize="13"
                            Click="OnSettingsClicked"
                            ToolTip="Open Now Playing settings"
                            AutomationProperties.Name="Open Now Playing settings"
                            AutomationProperties.AutomationId="NowPlayingOpenSettingsButton" />
                </StackPanel>
            </Grid>

            <!-- Bottom Row: Tabular Timestamps & Seek Slider -->
            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding ElapsedText}"
                           VerticalAlignment="Center"
                           FontFamily="{DynamicResource ShimaFontFamily}"
                           FontSize="11"
                           Typography.NumeralAlignment="Tabular"
                           Foreground="{DynamicResource TextMuted}"
                           AutomationProperties.AutomationId="NowPlayingElapsedText" />

                <Slider x:Name="SeekSlider"
                        Grid.Column="2"
                        Style="{StaticResource MediaSeekSliderStyle}"
                        Minimum="0"
                        Maximum="{Binding DurationSeconds}"
                        Value="{Binding ProgressSeconds, Mode=OneWay}"
                        IsEnabled="{Binding CanSeek}"
                        PreviewMouseLeftButtonDown="OnSeekPreviewMouseDown"
                        PreviewMouseLeftButtonUp="OnSeekPreviewMouseUp"
                        LostMouseCapture="OnSeekLostMouseCapture"
                        ValueChanged="OnSeekValueChanged"
                        AutomationProperties.Name="Seek track position"
                        AutomationProperties.AutomationId="NowPlayingSeekSlider" />

                <TextBlock Grid.Column="4"
                           Text="{Binding DurationText}"
                           VerticalAlignment="Center"
                           FontFamily="{DynamicResource ShimaFontFamily}"
                           FontSize="11"
                           Typography.NumeralAlignment="Tabular"
                           Foreground="{DynamicResource TextMuted}"
                           AutomationProperties.AutomationId="NowPlayingDurationText" />
            </Grid>
        </Grid>

        <!-- Clean Empty State -->
        <Grid Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
            <Button x:Name="EmptyStateSettingsGearButton"
                    Style="{StaticResource TransportIconButtonStyle}"
                    Width="24"
                    Height="24"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Foreground="{DynamicResource TextMuted}"
                    Content="&#x2699;"
                    FontSize="13"
                    Click="OnSettingsClicked"
                    ToolTip="Open Now Playing settings"
                    AutomationProperties.Name="Open Now Playing settings"
                    AutomationProperties.AutomationId="NowPlayingEmptyOpenSettingsButton" />

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <Border Width="42"
                        Height="42"
                        CornerRadius="21"
                        Background="{DynamicResource SurfaceElevated}"
                        BorderBrush="{DynamicResource BorderHairline}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,8">
                    <Path Data="M11,3 L11,14.5 C10.4,14.2 9.7,14 9,14 C7.1,14 5.5,15.3 5.5,17 C5.5,18.7 7.1,20 9,20 C10.9,20 12.5,18.7 12.5,17 L12.5,7 L18,5.8 L18,12.5 C17.4,12.2 16.7,12 16,12 C14.1,12 12.5,13.3 12.5,15 C12.5,16.7 14.1,18 16,18 C17.9,18 19.5,16.7 19.5,15 L19.5,1.5 L11,3 Z"
                          Fill="{DynamicResource TextMuted}"
                          Width="18"
                          Height="18"
                          Stretch="Uniform" />
                </Border>
                <TextBlock Text="Nothing playing"
                           HorizontalAlignment="Center"
                           FontFamily="{DynamicResource ShimaFontFamily}"
                           FontSize="13.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="Start audio or video playback in any media app."
                           HorizontalAlignment="Center"
                           Margin="0,2,0,0"
                           FontFamily="{DynamicResource ShimaFontFamily}"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextMuted}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
