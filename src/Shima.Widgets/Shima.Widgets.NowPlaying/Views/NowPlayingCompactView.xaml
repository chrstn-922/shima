<UserControl x:Class="Shima.Widgets.NowPlaying.Views.NowPlayingCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="{Binding AccessibleStatus}"
             AutomationProperties.AutomationId="NowPlayingCompactView">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 18x18 Rounded Artwork Thumbnail or Fallback Music Icon -->
        <Border x:Name="CompactArtworkBorder"
                Grid.Column="0"
                Width="18"
                Height="18"
                CornerRadius="5"
                Background="{DynamicResource SurfaceElevated}"
                VerticalAlignment="Center"
                Margin="0,0,8,0"
                AutomationProperties.AutomationId="NowPlayingCompactArtworkBorder">
            <Grid Width="18" Height="18">
                <Grid.Clip>
                    <RectangleGeometry Rect="0,0,18,18" RadiusX="5" RadiusY="5" />
                </Grid.Clip>

                <Path Data="M11,3 L11,14.5 C10.4,14.2 9.7,14 9,14 C7.1,14 5.5,15.3 5.5,17 C5.5,18.7 7.1,20 9,20 C10.9,20 12.5,18.7 12.5,17 L12.5,7 L18,5.8 L18,12.5 C17.4,12.2 16.7,12 16,12 C14.1,12 12.5,13.3 12.5,15 C12.5,16.7 14.1,18 16,18 C17.9,18 19.5,16.7 19.5,15 L19.5,1.5 L11,3 Z"
                      Fill="{DynamicResource AccentBrush}"
                      Width="10"
                      Height="10"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />

                <Image x:Name="CompactArtworkImage"
                       Source="{Binding ArtworkBitmap}"
                       Width="18"
                       Height="18"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding ShowArtworkInCompactPill, Converter={StaticResource BoolToVis}}" />

                <Border CornerRadius="5"
                        BorderBrush="{DynamicResource BorderHairline}"
                        BorderThickness="1"
                        IsHitTestVisible="False" />
            </Grid>
        </Border>

        <TextBlock Grid.Column="1"
                   Text="{Binding CompactTitle}"
                   VerticalAlignment="Center"
                   FontFamily="{DynamicResource ShimaFontFamily}"
                   FontSize="11.5"
                   FontWeight="Medium"
                   Foreground="{DynamicResource TextPrimary}"
                   TextTrimming="CharacterEllipsis" />

        <Grid x:Name="TrailingDotSlot"
              Grid.Column="2"
              VerticalAlignment="Center"
              Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}">
            <Ellipse x:Name="PlayingAccentDot"
                     Width="6"
                     Height="6"
                     Margin="8,0,0,0"
                     VerticalAlignment="Center"
                     Fill="{DynamicResource AccentBrush}"
                     AutomationProperties.AutomationId="NowPlayingCompactAccentDot" />
        </Grid>
    </Grid>
</UserControl>
