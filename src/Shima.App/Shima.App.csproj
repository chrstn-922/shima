<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Shima.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shima.Core\Shima.Core.csproj" />
    <ProjectReference Include="..\Shima.WindowsInterop\Shima.WindowsInterop.csproj" />
    <ProjectReference Include="..\Shima.Infrastructure\Shima.Infrastructure.csproj" />
    <ProjectReference Include="..\Shima.Presentation\Shima.Presentation.csproj" />
    <ProjectReference Include="..\Shima.Widgets\Shima.Widgets.Clock\Shima.Widgets.Clock.csproj" />
    <ProjectReference Include="..\Shima.Widgets\Shima.Widgets.NowPlaying\Shima.Widgets.NowPlaying.csproj" />
    <ProjectReference Include="..\Shima.Widgets\Shima.Widgets.FocusTimer\Shima.Widgets.FocusTimer.csproj" />
    <ProjectReference Include="..\Shima.Widgets\Shima.Widgets.Notes\Shima.Widgets.Notes.csproj" />
    <ProjectReference Include="..\Shima.Widgets\Shima.Widgets.Inbox\Shima.Widgets.Inbox.csproj" />
    <ProjectReference Include="..\Shima.Widgets\Shima.Widgets.Clipboard\Shima.Widgets.Clipboard.csproj" />
    <ProjectReference Include="..\Shima.Widgets\Shima.Widgets.VolumeMixer\Shima.Widgets.VolumeMixer.csproj" />
    <ProjectReference Include="..\Shima.Widgets\Shima.Widgets.Developer\Shima.Widgets.Developer.csproj" />
    <ProjectReference Include="..\Shima.AgentBridge\Shima.AgentBridge.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <Target Name="CopyAgentBridgeOutputs" AfterTargets="Build">
    <PropertyGroup>
      <_AgentBridgeOutDir Condition="'$(RuntimeIdentifier)' != ''">..\Shima.AgentBridge\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\</_AgentBridgeOutDir>
      <_AgentBridgeOutDir Condition="'$(RuntimeIdentifier)' == ''">..\Shima.AgentBridge\bin\$(Configuration)\$(TargetFramework)\</_AgentBridgeOutDir>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(_AgentBridgeOutDir)')">
      <AgentBridgeFiles Include="$(_AgentBridgeOutDir)Shima.AgentBridge.*" />
    </ItemGroup>
    <Copy SourceFiles="@(AgentBridgeFiles)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="'@(AgentBridgeFiles)' != ''" />
  </Target>
</Project>
